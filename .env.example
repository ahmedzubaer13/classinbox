# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=classinbox-submissions

# Teacher dashboard password (set a long unique password)
TEACHER_PASSWORD=change-this-to-a-long-password

# Random 32+ character secret used to sign the teacher session cookie
TEACHER_SESSION_SECRET=replace-with-a-long-random-secret

# Public base URL, e.g. https://classinbox.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upload constraints
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_SUBMISSION=10
